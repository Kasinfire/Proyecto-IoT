    "name": "descifrar y repartir",
    "func": "const r = global.get('orquesta').alMqtt(msg.topic, msg.payload);\nfor (const m of r.ws) node.send([{ payload: JSON.stringify(m) }, null]);\nfor (const m of r.mqtt) node.send([null, { topic: m.topic, payload: m.payload }]);\nreturn null;",
