  {
    "id": "orq_api",
    "type": "function",
    "z": "orq_flujo",
    "x": 400,
    "y": 720,
    "wires": [
      [
        "orq_resp"
      ],
      [
        "orq_wsout"
      ],
      [
        "orq_espera"
      ],
      [
        "orq_out"
      ]
    ],
    "name": "API",
    "func": "const metodo = msg.req.method;\n// Otro sitio abierto en el navegador no puede mandar JSON aquí sin permiso.\nif (metodo === 'POST' && !msg.req.is('application/json')) {\n  msg.statusCode = 415;\n  msg.payload = { error: 'se espera JSON' };\n  return [msg, null, null];\n}\nconst r = global.get('orquesta').alHttp(metodo, msg.req.path.replace('/api/', ''), msg.payload);\nmsg.statusCode = r.codigo;\nmsg.headers = { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' };\nmsg.payload = r.codigo === 204 ? '' : JSON.stringify(r.cuerpo);\nnode.send([msg, null, null]);\nfor (const m of r.ws) node.send([null, { payload: JSON.stringify(m) }, null]);\n// Una tecla sale de inmediato; un modo espera a que la pantalla conozca su id.\nfor (const m of r.mqtt) {\n  const pub = { topic: m.topic, payload: m.payload };\n  node.send(r.urgente ? [null, null, null, pub] : [null, null, pub, null]);\n}\nreturn null;",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
