    "name": "ponerla al día",
    "func": "if (msg.status.event !== 'connect' || !msg.status._session) return null;\nfor (const m of global.get('orquesta').alConectar()) node.send({ payload: JSON.stringify(m), _session: msg.status._session });\nreturn null;",
